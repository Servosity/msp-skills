# Code owners for msp-skills. These owners are requested for review on PRs that
# touch the matching paths. See:
# https://docs.github.com/en/repositories/managing-your-repositories-settings-and-features/customizing-your-repository/about-code-owners

# Default owner for everything in the repo.
*                       @Servosity

# Release, CI, and catalog tooling - changes here affect every skill.
/.github/                @Servosity
/tools/                  @Servosity
/catalog.json            @Servosity

# Seed skills maintained by Servosity.
/skills/halopsa/         @Servosity
/skills/servosity/       @Servosity

# SECURITY GATE - the deterministic supply-chain control and its policy. A change
# here can weaken every connector's defense, so it MUST get a security-maintainer
# review (the security-gate workflow also fails any PR that edits these, so they
# can't be self-approved). Keep these explicit even if /tools/ ownership narrows.
/tools/maintainer/check_security_gate.py       @Servosity
/tools/maintainer/dep_allowlist.json           @Servosity
/tools/maintainer/security_suppressions.json   @Servosity
/.semgrep.yml                                  @Servosity
/.github/workflows/security-gate.yml           @Servosity
/.github/workflows/release.yml                 @Servosity
