  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "format": "Bearer {BETTERSTACK_API_TOKEN}",
    "in": "header",
    "env_vars": [
      "BETTERSTACK_API_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "BETTERSTACK_API_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
