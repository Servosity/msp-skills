          "required": true
        }
      ]
    },
    {
      "name": "computers_list",
      "description": "List computers across the fleet (paginated, filterable). Optional: page (default: 1), page-size (default: 100), condition (plus 1 more). Returns array of Computer.",
      "method": "GET",
      "path": "/Computers",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "1-based page number"
        },
        {
          "name": "page-size",
          "wire_name": "pagesize",
          "type": "int",
          "location": "query",
          "description": "Items per page (max 1000)"
        },
        {
          "name": "condition",
          "type": "string",
          "location": "query",
          "description": "Filter expression, e.g. 'Status='Online'' or 'Client.Name like '%Acme%''"
        },
        {
          "name": "order-by",
          "wire_name": "orderby",
          "type": "string",
          "location": "query",
          "description": "Sort expression, e.g. 'ComputerName asc'"
        }
      ]
    },
    {
      "name": "computers_patching-stats",
