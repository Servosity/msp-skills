      "description": "Deploy all approved patches (WRITE — triggers fleet patch deployment). Optional: computer-ids. Returns the new PatchActionResult.",
      "method": "POST",
      "path": "/PatchActions/DeployAllApproved",
      "params": [
        {
          "name": "computer-ids",
          "wire_name": "ComputerIds",
          "type": "string",
