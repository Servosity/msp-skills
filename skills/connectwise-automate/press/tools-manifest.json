{
  "api_name": "connectwise-automate",
  "base_url": "https://{server}/cwa/api/v1",
  "description": "Sync your entire ConnectWise Automate fleet into local SQLite and answer cross-client questions the per-server web UI can't: fleet-wide health roll-ups, stale-agent sweeps, patch-compliance-by-client, and overnight drift.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "format": "Bearer {CONNECTWISE_AUTOMATE_TOKEN}",
    "in": "header",
    "env_vars": [
      "CONNECTWISE_AUTOMATE_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "CONNECTWISE_AUTOMATE_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ],
    "key_url": "https://docs.connectwise.com/ConnectWise_Automate"
  },
  "required_headers": [],
  "tools": [
    {
      "name": "alerts_get",
      "description": "Get a single alert by Id. Required: id. Returns the Alert.",
      "method": "GET",
      "path": "/Alerts/{alertId}",
      "params": [
        {
          "name": "id",
          "wire_name": "alertId",
          "type": "int",
          "location": "path",
          "description": "Alert Id",
          "required": true
        }
      ]
    },
    {
      "name": "alerts_list",
      "description": "List open alerts across all computers. Optional: page (default: 1), page-size (default: 100), condition (plus 1 more). Returns array of Alert.",
      "method": "GET",
      "path": "/Alerts",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "1-based page number"
        },
        {
          "name": "page-size",
          "wire_name": "pagesize",
          "type": "int",
          "location": "query",
          "description": "Items per page (max 1000)"
        },
        {
          "name": "condition",
          "type": "string",
          "location": "query",
          "description": "Filter expression, e.g. 'Priority\u003e=3'"
        },
        {
          "name": "order-by",
          "wire_name": "orderby",
          "type": "string",
          "location": "query",
          "description": "Sort expression"
        }
      ]
    },
    {
      "name": "apitoken_mint",
      "description": "Mint a bearer token from username + password (needs CONNECTWISE_AUTOMATE_SERVER + clientId header). Required: username, password. Optional: two-factor. Returns the new TokenResult. (public)",
      "method": "POST",
      "path": "/apitoken",
      "no_auth": true,
      "params": [
        {
          "name": "username",
          "wire_name": "UserName",
          "type": "string",
          "location": "body",
          "description": "Automate username",
          "required": true
        },
        {
          "name": "password",
          "wire_name": "Password",
          "type": "string",
          "location": "body",
          "description": "Automate password",
          "required": true
        },
        {
          "name": "two-factor",
          "wire_name": "TwoFactorPasscode",
          "type": "string",
          "location": "body",
          "description": "2FA passcode (if enabled)"
        }
      ]
    },
    {
      "name": "apitoken_refresh",
      "description": "Refresh an existing (still-valid) bearer token. Required: token. Returns the new TokenResult.",
      "method": "POST",
      "path": "/apitoken/refresh",
      "params": [
        {
          "name": "token",
          "wire_name": "Token",
          "type": "string",
          "location": "body",
          "description": "Current bearer token to refresh",
          "required": true
        }
      ]
    },
    {
      "name": "clients_get",
      "description": "Get a single client by Id. Required: id. Returns the Client.",
      "method": "GET",
      "path": "/Clients/{clientId}",
      "params": [
        {
          "name": "id",
          "wire_name": "clientId",
          "type": "int",
          "location": "path",
          "description": "Client Id",
          "required": true
        }
      ]
    },
    {
      "name": "clients_list",
      "description": "List all clients. Optional: page (default: 1), page-size (default: 100), condition (plus 1 more). Returns array of Client.",
      "method": "GET",
      "path": "/Clients",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "1-based page number"
        },
        {
          "name": "page-size",
          "wire_name": "pagesize",
          "type": "int",
          "location": "query",
          "description": "Items per page (max 1000)"
        },
        {
          "name": "condition",
          "type": "string",
          "location": "query",
          "description": "Filter expression"
        },
        {
          "name": "order-by",
          "wire_name": "orderby",
          "type": "string",
          "location": "query",
          "description": "Sort expression"
        }
      ]
    },
    {
      "name": "commands_get",
      "description": "Get a single command by Id. Required: id. Returns the Command.",
      "method": "GET",
      "path": "/Commands/{commandId}",
      "params": [
        {
          "name": "id",
          "wire_name": "commandId",
          "type": "int",
          "location": "path",
          "description": "Command Id",
          "required": true
        }
      ]
    },
    {
      "name": "commands_list",
      "description": "List all available commands. Optional: page (default: 1), page-size (default: 100), condition. Returns array of Command.",
      "method": "GET",
      "path": "/Commands",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "1-based page number"
        },
        {
          "name": "page-size",
          "wire_name": "pagesize",
          "type": "int",
          "location": "query",
          "description": "Items per page (max 1000)"
        },
        {
          "name": "condition",
          "type": "string",
          "location": "query",
          "description": "Filter expression"
        }
      ]
    },
    {
      "name": "computers_alerts",
      "description": "Open alerts for one computer. Required: id. Returns array of Alert.",
      "method": "GET",
      "path": "/Computers/{computerId}/Alerts",
      "params": [
        {
          "name": "id",
          "wire_name": "computerId",
          "type": "int",
          "location": "path",
          "description": "Computer Id",
          "required": true
        }
      ]
    },
    {
      "name": "computers_command-execute",
      "description": "Execute a command on one computer (WRITE — runs a real command on the agent). Required: id, command-id. Optional: parameters. Returns the new CommandHistory.",
      "method": "POST",
      "path": "/Computers/{computerId}/CommandExecute",
      "params": [
        {
          "name": "id",
          "wire_name": "computerId",
          "type": "int",
          "location": "path",
          "description": "Computer Id",
          "required": true
        },
        {
          "name": "command-id",
          "wire_name": "CommandId",
          "type": "int",
          "location": "body",
          "description": "Command Id (see `commands list`)",
          "required": true
        },
        {
          "name": "parameters",
          "wire_name": "Parameters",
          "type": "string",
          "location": "body",
          "description": "Command parameters string"
        }
      ]
    },
    {
      "name": "computers_command-history",
      "description": "Recent command execution history for one computer. Required: id. Returns array of CommandHistory.",
      "method": "GET",
      "path": "/Computers/{computerId}/CommandHistory",
      "params": [
        {
          "name": "id",
          "wire_name": "computerId",
