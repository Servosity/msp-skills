  "novel_features": [
    {
      "name": "Storage growth / drift",
      "command": "storage growth",
      "description": "See which devices and customers are growing their backup storage fastest, from timestamped local snapshots."
    },
    {
      "name": "Fleet failure sweep",
      "command": "devices failures",
      "description": "Every device across all customers whose last backup session failed, aborted, errored, had no selection, never started or reported an unrecognised status, decoded to status names."
    },
    {
      "name": "Stale-device triage",
      "command": "devices stale",
      "description": "Devices with no successful backup in N days, ranked by staleness and grouped by customer."
    },
    {
      "name": "Status drift / what-changed",
      "command": "devices changes",
      "description": "Devices whose backup status flipped between the two latest snapshots of the same partner tree: regressions and recoveries without re-sweeping the fleet."
    },
    {
      "name": "Fleet health rollup",
      "command": "fleet health",
      "description": "One-screen rollup: total devices, healthy, failed, stale, never-run and unknown status, with a per-customer breakdown."
    },
    {
      "name": "Billing usage report",
      "command": "billing usage",
      "description": "Per-device SKU, used storage, and M365 seat counts with column codes decoded — the month-end billing export in one command."
    },
    {
      "name": "SKU change / billing delta",
      "command": "billing changes",
      "description": "Devices whose plan changed since last month — current SKU vs Cove's built-in previous-month SKU column."
    },
    {
      "name": "Data-source coverage",
      "command": "devices sources",
      "description": "Which data sources each device protects (Files, System State, SQL, Hyper-V, Microsoft 365), decoded fleet-wide, with a filter for devices missing one."
    },
    {
      "name": "Console activity digest",
      "command": "fleet activity",
      "description": "Who did what in the Cove console: audit-trail actions grouped by user and operation across every sub-partner, with a breakdown by result."
    }
  ]
}
