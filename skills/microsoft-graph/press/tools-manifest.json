{
  "api_name": "microsoft-graph",
  "base_url": "https://graph.microsoft.com/v1.0",
  "description": "The maintained single-binary successor to the retiring mgc — every MSP-relevant Microsoft Graph surface, plus an offline store that finds wasted licenses, privileged-access risks, and stale devices no single API call can.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "format": "Bearer {MICROSOFT_GRAPH_TOKEN}",
    "env_vars": [
      "MICROSOFT_GRAPH_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "MICROSOFT_GRAPH_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "devices_get",
      "description": "Get an Entra device by object id. Required: id. Optional: properties. Returns the Device.",
      "method": "GET",
      "path": "/devices/{id}",
      "params": [
        {
          "name": "id",
          "type": "string",
          "location": "path",
          "description": "Device object id (e.g. 000005c3-b7a6-4c61-89fc-80bf5ccfc366)",
          "required": true
        },
        {
          "name": "properties",
          "wire_name": "$select",
          "type": "string",
          "location": "query",
          "description": "Comma-separated Graph properties to request (OData $select)"
        }
      ]
    },
    {
      "name": "devices_list",
      "description": "List Entra-registered devices. Optional: filter, top, skip (plus 2 more). Returns array of Device.",
      "method": "GET",
      "path": "/devices",
      "params": [
        {
          "name": "filter",
          "wire_name": "$filter",
          "type": "string",
          "location": "query",
          "description": "OData filter, e.g. 'operatingSystem eq 'Windows''"
        },
        {
          "name": "top",
          "wire_name": "$top",
          "type": "int",
          "location": "query",
          "description": "Max devices per page (OData $top)"
        },
        {
          "name": "skip",
          "wire_name": "$skip",
          "type": "int",
          "location": "query",
          "description": "Skip the first N results (OData $skip)"
        },
        {
          "name": "orderby",
          "wire_name": "$orderby",
          "type": "string",
          "location": "query",
          "description": "Sort expression, e.g. 'displayName'"
        },
        {
          "name": "properties",
          "wire_name": "$select",
          "type": "string",
          "location": "query",
          "description": "Comma-separated Graph properties to request (OData $select)"
        }
