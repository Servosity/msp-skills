  "novel_features": [
    {
      "name": "License waste finder",
      "command": "licenses waste",
      "description": "Surfaces every tenant SKU where you are paying for more seats than you use, ranked by unused seats."
    },
    {
      "name": "Licensed-orphan audit",
      "command": "licenses orphans",
      "description": "Lists disabled and guest accounts that still hold paid SKUs — licenses you are paying for but nobody is using."
    },
    {
      "name": "Privileged-access audit",
      "command": "admins audit",
      "description": "Lists every holder of a privileged directory role with the role name, account-enabled state, and guest/disabled risk flags."
    },
    {
      "name": "Fresh-alert triage window",
      "command": "security triage",
      "description": "Counts the open security alerts created in a recent time window, grouped by severity and detection source."
    },
    {
      "name": "Intune compliance drift",
      "command": "managed-devices drift",
      "description": "Flags Intune devices that are non-compliant, unencrypted, or have not checked in within a time window, attributed to their assigned user."
    },
    {
      "name": "Whole-tenant posture rollup",
      "command": "tenant snapshot",
      "description": "One agent-readable summary of the tenant: user and guest counts, license waste, admin count, open high-severity alerts, and non-compliant device count."
    },
    {
      "name": "License reassignment map",
      "command": "licenses map",
