{
  "api_name": "quickbooks",
  "base_url": "https://quickbooks.api.intuit.com/v3/company/YOUR_REALM_ID",
  "description": "QuickBooks Online Accounting API CLI for MSPs and finance teams — read, write, sync, and analyze customers, invoices, items, payments, bills, vendors, accounts, and journal entries with an offline SQLite mirror and agent-native output.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "mcp": {
    "endpoint_tools": "hidden",
    "orchestration": "code"
  },
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "format": "Bearer {QUICKBOOKS_ACCESS_TOKEN}",
    "in": "header",
    "env_vars": [
      "QUICKBOOKS_ACCESS_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "QUICKBOOKS_ACCESS_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [
    {
      "name": "Accept",
      "value": "application/json"
    }
  ],
  "tools": [
    {
      "name": "accounts_create",
      "description": "Create an account in the chart of accounts. Required: name. Optional: account-type, account-sub-type, acct-num (plus 2 more). Returns the new Account.",
      "method": "POST",
      "path": "/account",
      "params": [
        {
          "name": "name",
          "wire_name": "Name",
          "type": "string",
          "location": "body",
          "description": "Unique account name",
          "required": true
        },
        {
          "name": "account-type",
          "wire_name": "AccountType",
          "type": "string",
          "location": "body",
          "description": "Account type, e.g. Bank, Accounts Receivable, Expense"
        },
        {
          "name": "account-sub-type",
          "wire_name": "AccountSubType",
          "type": "string",
          "location": "body",
          "description": "Account subtype, e.g. CashOnHand, Checking"
        },
        {
          "name": "acct-num",
          "wire_name": "AcctNum",
          "type": "string",
          "location": "body",
          "description": "Account number"
        },
        {
          "name": "description",
          "wire_name": "Description",
          "type": "string",
          "location": "body",
          "description": "Account description"
        },
        {
          "name": "active",
          "wire_name": "Active",
          "type": "bool",
          "location": "body",
          "description": "Active flag"
        }
      ]
    },
    {
      "name": "accounts_get",
      "description": "Get a single account by Id. Required: id. Optional: minorversion (default: 75). Returns the Account.",
      "method": "GET",
      "path": "/account/{id}",
      "params": [
        {
          "name": "id",
          "type": "string",
          "location": "path",
          "description": "Account Id",
          "required": true
        },
        {
          "name": "minorversion",
          "type": "int",
          "location": "query",
          "description": "QBO API minor version"
        }
      ]
    },
    {
      "name": "accounts_list",
      "description": "List/query accounts. Optional: query, minorversion (default: 75). Returns array of Account.",
      "method": "GET",
      "path": "/query",
      "params": [
        {
          "name": "query",
          "type": "string",
          "location": "query",
          "description": "QBO query string"
        },
        {
          "name": "minorversion",
          "type": "int",
          "location": "query",
          "description": "QBO API minor version"
        }
      ]
    },
