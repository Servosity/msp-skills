  "server": {
    "type": "binary",
    "entry_point": "bin/riverside-fm-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/riverside-fm-pp-mcp",
      "args": [],
      "env": {
        "RIVERSIDE_FM_BASE_URL": "${user_config.riverside_fm_base_url}"
      }
    }
  },
  "user_config": {
    "riverside_fm_base_url": {
      "type": "string",
      "title": "Riverside API base URL",
      "description": "Base URL for the Riverside API. Leave the prefilled default unless your account uses a different host. There is no API key: run `riverside-fm-cli auth login --chrome` on this machine first, and the MCP server reuses the browser session it saves.",
      "required": false,
      "default": "https://riverside.com"
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
