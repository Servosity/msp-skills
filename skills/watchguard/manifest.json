{
  "manifest_version": "0.3",
  "name": "watchguard-pp-mcp",
  "display_name": "WatchGuard Cloud",
  "version": "0.1.3",
  "description": "WatchGuard Cloud's Firebox, Endpoint Security, ThreatSync, AuthPoint, NDR and MSP account APIs in one CLI and MCP server.",
  "author": {
    "name": "Servosity Inc."
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/watchguard-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/watchguard-pp-mcp",
      "args": [],
      "env": {
        "WATCHGUARD_ACCOUNT_ID": "${user_config.watchguard_account_id}",
        "WATCHGUARD_API_KEY": "${user_config.watchguard_api_key}",
        "WATCHGUARD_CLIENT_ID": "${user_config.watchguard_client_id}",
        "WATCHGUARD_CLIENT_SECRET": "${user_config.watchguard_client_secret}"
      }
    }
  },
  "user_config": {
    "watchguard_account_id": {
      "type": "string",
      "title": "WATCHGUARD_ACCOUNT_ID",
      "description": "Sets WATCHGUARD_ACCOUNT_ID for the endpoint template variable {accountId}.",
      "required": true
    },
    "watchguard_api_key": {
      "type": "string",
      "title": "WATCHGUARD_API_KEY",
      "description": "WatchGuard Cloud API key (WatchGuard-API-Key header).",
      "sensitive": true,
      "required": true
    },
    "watchguard_client_id": {
      "type": "string",
      "title": "WATCHGUARD_CLIENT_ID",
      "description": "Sets WATCHGUARD_CLIENT_ID for the WatchGuard Cloud MCP server.",
      "sensitive": true,
      "required": true
    },
    "watchguard_client_secret": {
      "type": "string",
      "title": "WATCHGUARD_CLIENT_SECRET",
      "description": "Sets WATCHGUARD_CLIENT_SECRET for the WatchGuard Cloud MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "printing_press_version": "4.35.1",
