{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Servosity/watchguard-mcp",
  "title": "WatchGuard MCP",
  "description": "WatchGuard Cloud Firebox, Endpoint Security, ThreatSync, NDR and AuthPoint APIs for every customer",
  "version": "0.1.3",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/servosity/msp-skills/main/docs/assets/social/watchguard/watchguard-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/servosity/msp-skills",
    "source": "github",
    "subfolder": "skills/watchguard"
  },
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/servosity/msp-skills/releases/download/watchguard-v0.1.3/watchguard-mcp.mcpb",
      "version": "0.1.3",
      "fileSha256": "PLACEHOLDER_SHA256_FILLED_BY_CI",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WATCHGUARD_CLIENT_ID",
          "description": "WatchGuard Cloud API Access ID (read-write or read-only).",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "WATCHGUARD_CLIENT_SECRET",
          "description": "Password for that Access ID.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "WATCHGUARD_API_KEY",
          "description": "WatchGuard Cloud API key (WatchGuard-API-Key header).",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "WATCHGUARD_ACCOUNT_ID",
          "description": "Your WatchGuard Cloud account ID (ACC-... or WGC-...).",
          "isRequired": true,
          "isSecret": false
        }
      ]
    }
  ]
}
