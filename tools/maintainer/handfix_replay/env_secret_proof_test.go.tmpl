//
// Proof template for tools/maintainer/replay_handfixes.py. It is never written
// into a connector: the tool adds it to the build with go test -overlay. PREFIX
// is the connector's environment prefix.

package config

import (
	"os"
	"path/filepath"
	"strings"
	"testing"
	"time"
)

// Retirement proof (fleet_handfixes.json: env-oauth-secrets-not-persisted).
// OAuth client credentials that reach the process through the environment
// must not be written to ANY file under the config home by a token save,
// while the minted token itself still is (the control proves the save ran).
func TestRetireProofEnvClientSecretNeverReachesDisk(t *testing.T) {
	root := t.TempDir()
	for _, k := range []string{"HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "APPDATA", "LOCALAPPDATA"} {
		t.Setenv(k, filepath.Join(root, strings.ToLower(k)))
	}
	t.Setenv("PREFIX_CONFIG", filepath.Join(root, "cfg", "config.toml"))
	t.Setenv("PREFIX_CLIENT_ID", "env-id-RETIREPROOF")
	t.Setenv("PREFIX_CLIENT_SECRET", "env-secret-RETIREPROOF")
	cfg, err := Load("")
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if err := cfg.SaveTokens(cfg.ClientID, cfg.ClientSecret, "minted-token-RETIREPROOF", "", time.Now().Add(time.Hour)); err != nil {
		t.Fatalf("SaveTokens: %v", err)
	}
	var sawToken bool
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info.IsDir() {
			return nil
		}
		b, _ := os.ReadFile(p)
		s := string(b)
		if strings.Contains(s, "env-secret-RETIREPROOF") || strings.Contains(s, "env-id-RETIREPROOF") {
			t.Errorf("an environment-supplied client credential was written to %s", p)
		}
		if strings.Contains(s, "minted-token-RETIREPROOF") {
			sawToken = true
		}
		return nil
	})
	if !sawToken {
		t.Fatal("control failed: the minted token was not written anywhere, so this probe proves nothing")
	}
}
